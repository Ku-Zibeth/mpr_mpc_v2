+            radius=length/2*np.abs(np.sum(f[:,None,None]*axes,-1))+width/2*np.abs(np.sum(n[:,None,None]*axes,-1))
+            radius+=ex[None,:,None,0]*np.abs(np.sum(ob[None,:,None,0]*axes,-1))+ex[None,:,None,1]*np.abs(np.sum(ob[None,:,None,1]*axes,-1))

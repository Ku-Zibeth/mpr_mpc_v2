+ initial_obs=obs.cpu().tolist();agent.act(obs,t0=False,eval_mode=True);r=agent.last_plan;c=agent.planner.last_context
+ baseline=r.refined_actions;mean=r.debug['final_mppi_mean'].to(agent.device)
